# Copy to .env (never commit .env). Without keys, answers are simulated (demo mode).

# Open engine (free): Tavily search + a Groq model that writes the cited answer.
# https://tavily.com (1,000 free searches a month)
TAVILY_API_KEY=
# https://console.groq.com (free models)
GROQ_API_KEY=
# https://aistudio.google.com (free tier is fine: used for the "AI memory" check, no web search)
GEMINI_API_KEY=

# ENGINE=auto                # auto | open | gemini | demo. auto = open if its keys are set, else gemini, else demo
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b   # answer writers; calls rotate between them
# GEMINI_MODEL=gemini-3.8-flash      # for ENGINE=gemini (search grounding needs a billing-enabled project)
# MEMORY_MODEL=gemini-3.5-flash-lite # for the AI memory check
# MEMORY_QUESTIONS=5         # 0 turns the memory check off
# RUNS_PER_QUESTION=         # default: 1 for open, 3 for gemini
# DAILY_CALL_BUDGET=         # engine calls per UTC day across all visitors. Default: 30 for open, 450 for gemini
# DEFAULT_QUESTIONS=10       # how many questions to suggest when none are given
# MAX_QUESTIONS=20
# REPORTS_PER_HOUR=5         # per visitor IP
# CHECKS_PER_HOUR=30         # quick checks + question suggestions per visitor IP
# CONCURRENCY=4
# DB_PATH=data/citecheck.db
# DEMO_MODE=1                # force simulated answers even with keys
# SOURCE_URL=https://github.com/you/citecheck   # footer link to the code
